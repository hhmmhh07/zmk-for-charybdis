#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE      &kp EXCLAMATION  &kp AT_SIGN  &kp POUND     &kp DOLLAR    &kp PERCENT    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CAPSLOCK
&kp TAB         &kp Q            &kp W        &kp E         &kp R         &kp T          &kp Y          &kp U          &kp I         &kp O                 &kp P                  &kp BACKSPACE
&kp LEFT_SHIFT  &kp A            &kp S        &kp D         &kp F         &kp G          &kp H          &kp J          &kp K         &kp L                 &kp SEMI               &kp RIGHT_SHIFT
&kp LCTRL       &kp Z            &kp X        &kp C         &kp V         &kp B          &kp N          &kp M          &kp COMMA     &kp DOT               &kp SLASH              &kp RIGHT_CONTROL
                                              &kp LEFT_WIN  &kp SPACE     &mo 2          &mo 1          &kp ENTER
                                                            &kp LEFT_ALT  &mo 3          &kp RIGHT_ALT
            >;
        };

        symbol {
            bindings = <
&none   &kp F1         &none          &none          &none         &none            &none         &none   &none    &none    &none    &none
&trans  &kp LS(EXCL)   &kp LS(AT)     &kp LS(POUND)  &kp LS(DLLR)  &kp LS(LBRC)     &kp LS(RBRC)  &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp LS(DQT)      &kp LS(PIPE)  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &kp LS(LPAR)   &kp LS(RPAR)   &kp LS(UNDER)  &kp LS(PLUS)  &kp LS(TILDE)    &kp DEL       &kp F9  &kp F10  &kp F11  &kp F12  &trans
                                      &kp LEFT_WIN   &trans        &mo 5            &trans        &trans
                                                     &trans        &none            &trans
            >;
        };

        arrow {
            bindings = <
&none   &none             &none              &none           &none            &none                &none         &none         &none         &kp DELETE    &none         &none
&trans  &kp BACKSLASH     &kp HOME           &kp UP          &kp END          &kp UNDERSCORE       &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp ASTERISK  &trans
&trans  &kp PIPE          &kp LEFT           &kp DOWN        &kp RIGHT        &kp DOUBLE_QUOTES    &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &trans
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp SQT              &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT       &trans
                                             &kp LEFT_WIN    &trans           &trans               &mo 5         &trans
                                                             &trans           &none                &trans
            >;
        };

        MOUSE {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none      &none           &none           &none            &none  &none
&none       &none         &mkp MB4      &mkp MCLK     &mkp MB5      &none           &none      &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none  &none
&trans      &kp LALT      &mkp RCLK     &mo 4         &mkp LCLK     &none           &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&trans      &none         &none         &none         &none         &none           &none      &none           &none           &none            &none  &bootloader
                                        &none         &none         &none           &mkp LCLK  &mkp RCLK
                                                      &none         &trans          &none
            >;
        };

        mouse-middle {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none      &none           &none           &none            &none  &none
&none       &none         &mkp MB4      &mkp MCLK     &mkp MB5      &none           &none      &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &none  &none
&trans      &kp LALT      &mkp RCLK     &trans        &mkp RCLK     &none           &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&trans      &none         &none         &none         &none         &none           &none      &none           &none           &none            &none  &bootloader
                                        &none         &none         &none           &mkp LCLK  &mkp RCLK
                                                      &none         &trans          &none
            >;
        };

        layer_5 {
            bindings = <
&none  &none  &none  &none  &none  &none     &none   &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none     &none   &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none     &none   &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none     &none   &none  &none  &none  &none  &none
                     &none  &none  &trans    &trans  &none
                            &none  &none     &none
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
