#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3        &kp N4        &kp N5       &kp N6         &kp N7  &kp N8     &kp N9   &kp N0     &kp CAPS
&kp TAB         &kp Q   &kp W   &kp E         &kp R         &kp T        &kp Y          &kp U   &kp I      &kp O    &kp P      &kp BACKSPACE
&kp LEFT_SHIFT  &kp A   &kp S   &kp D         &kp F         &kp G        &kp H          &kp J   &kp K      &kp L    &kp SEMI   &kp RIGHT_SHIFT
&kp LCTRL       &kp Z   &kp X   &kp C         &kp V         &kp B        &kp N          &kp M   &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_CONTROL
                                &kp LEFT_WIN  &mo 1         &kp SPACE    &kp ENTER      &mo 1
                                              &kp LEFT_ALT  &mo 3        &kp RIGHT_ALT
            >;
        };

        arrow {
            bindings = <
&none   &none   &none   &none         &none      &none               &none              &none      &none     &none      &none        &none
&trans  &kp N1  &kp N2  &kp N3        &kp N4     &none               &none              &kp GRAVE  &kp LBKT  &kp RBKT   &kp BSLH     &trans
&trans  &kp N5  &kp N6  &kp N7        &kp N8     &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp HOME   &kp UP    &kp END    &kp PAGE_UP  &trans
&trans  &kp N9  &kp N0  &kp MINUS     &kp EQUAL  &kp GRAVE           &kp BACKSLASH      &kp LEFT   &kp DOWN  &kp RIGHT  &kp PG_DN    &trans
                        &kp LEFT_WIN  &trans     &none               &none              &mo 5
                                      &none      &none               &none
            >;
        };

        symbol {
            bindings = <
&none   &none          &none          &none          &none         &none            &none         &none   &none    &none    &none    &none
&trans  &kp LS(EXCL)   &kp LS(AT)     &kp LS(POUND)  &kp LS(DLLR)  &none            &none         &kp F1  &kp F2   &kp F3   &kp F4   &trans
&trans  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(AMPS)   &kp LS(STAR)  &kp LS(LBRC)     &kp LS(RBRC)  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&trans  &kp LS(LPAR)   &kp LS(RPAR)   &kp LS(UNDER)  &kp LS(PLUS)  &kp LS(TILDE)    &kp LS(PIPE)  &kp F9  &kp F10  &kp F11  &kp F12  &trans
                                      &kp LEFT_WIN   &mo 5         &none            &none         &trans
                                                     &none         &none            &none
            >;
        };

        MOUSE {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none           &none           &none            &none  &none
&none       &none         &none         &none         &none         &none           &none  &none           &none           &none            &none  &none
&trans      &none         &mkp MB4      &mkp MCLK     &mkp MB5      &none           &none  &none           &mmv MOVE_UP    &none            &none  &none
&trans      &kp LEFT_ALT  &mkp RCLK     &mo 4         &mkp LCLK     &none           &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &bootloader
                                        &none         &none         &none           &none  &none
                                                      &none         &trans          &none
            >;
        };

        mouse-middle {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none           &none           &none            &none  &none
&none       &none         &none         &none         &none         &none           &none  &none           &none           &none            &none  &none
&trans      &none         &mkp MB4      &mkp MCLK     &mkp MB5      &none           &none  &none           &mmv MOVE_UP    &none            &none  &none
&trans      &kp LEFT_ALT  &mkp RCLK     &trans        &mkp LCLK     &none           &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &bootloader
                                        &none         &none         &none           &none  &none
                                                      &none         &trans          &none
            >;
        };

        layer_5 {
            bindings = <
&none  &none  &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
&none  &none  &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
&none  &none  &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
&none  &none  &none  &none  &none   &none    &none  &none   &none  &none  &none  &none
                     &none  &trans  &none    &none  &trans
                            &none   &none    &none
            >;
        };
    };
};
